# ─────────────────────────────────────────────
# Dynamic RAG Knowledge Assistant — Environment
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── API Keys ──────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key          # Optional — only needed if using OpenAI provider

# ── Provider Selection ────────────────────────
# Embedding provider: "huggingface" (384-dim, default) | "openai" (1536-dim)
EMBEDDING_PROVIDER=huggingface

# LLM provider: "groq" (default) | "openai"
LLM_PROVIDER=groq

# ── Pinecone Index Names ─────────────────────
# Two indexes are needed because Pinecone fixes dimension per index.
PINECONE_INDEX_384=rag-384
PINECONE_INDEX_1536=rag-1536

# ── Pinecone Serverless Spec ─────────────────
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
